# Optional settings for `docker compose` (copy to .env at the project root). The app's own secrets live in backend/.env.

# Port the web app is published on
# WEB_PORT=5555

# The public address users open the app at; becomes the backend's allowed CORS origin
# PUBLIC_URL=http://localhost:5555

# postgres uses the DATABASE_* values in backend/.env. Use prod,postgres in production (needs real mail and a real PUBLIC_URL).
# SPRING_PROFILES_ACTIVE=postgres
