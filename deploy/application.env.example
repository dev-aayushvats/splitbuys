# Copy to /var/opt/splitbuys-back/application.env on the server, then:
#   chown springapp:springapp application.env && chmod 600 application.env
# Real secrets never go in git. Names match backend/.env.example.
#
# systemd's EnvironmentFile has NO trailing comments: anything after the = is part of the value. Keep comments on their own lines.

SPRING_PROFILES_ACTIVE=prod,postgres

# --- secrets ---
# at least 32 random characters, e.g. from: openssl rand -base64 48
APP_JWT_SECRET=
DATABASE_URL=jdbc:postgresql://HOST/DBNAME?sslmode=require
DATABASE_USERNAME=
DATABASE_PASSWORD=
# If DATABASE_URL uses Neon's pooled host (-pooler), also set DATABASE_MIGRATION_URL to the direct host.
# The prod profile refuses to start unless real email is enabled.
MAIL_ENABLED=true
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
# 32+ random characters; leave unset and the admin endpoints answer 404
# ADMIN_API_TOKEN=

# --- web origin(s) allowed to call the API: real origins only, never * and never localhost in production ---
CORS_ALLOWED_ORIGINS=https://app.example.com

# --- network ---
# Listen on localhost only: nginx is the only thing that should reach the app.
SERVER_ADDRESS=127.0.0.1
# Do NOT set CLIENT_IP_HEADER here. nginx overwrites X-Forwarded-For with the real client address and the app reads it
# from the right. CLIENT_IP_HEADER=CF-Connecting-IP is only for an API proxied by Cloudflare and unreachable any other way.

# --- memory: sized for a 512 MB droplet (measured: roughly 250-290 MB resident under load) ---
# Raise -Xmx (and the droplet) before raising anything else. A metaspace cap below about 160m crashed the app with
# OutOfMemoryError: Metaspace.
JAVA_OPTS="-Xms32m -Xmx160m -XX:MaxMetaspaceSize=192m -XX:ReservedCodeCacheSize=32m -Xss256k -XX:+UseSerialGC -XX:TieredStopAtLevel=1 -XX:CICompilerCount=1 -XX:-UsePerfData -XX:MaxDirectMemorySize=32m -XX:+ExitOnOutOfMemoryError"
MALLOC_ARENA_MAX=2
DATABASE_POOL_SIZE=5
SERVER_TOMCAT_THREADS_MAX=20

# --- push notifications (optional; leave these out to keep them off) ---
# Generate the pair on your own machine with: java deploy/GenerateVapidKeys.java  (the private key is a secret).
# Changing the pair later makes every existing subscription useless: people would have to turn notifications on again.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
