# Copy to .env (git-ignored) and fill in. Real environment variables take precedence.

# Required. At least 32 random characters, e.g.: openssl rand -base64 48
APP_JWT_SECRET=

# Optional
# Database. Default: a local SQLite file, nothing to set. To use PostgreSQL (e.g. Neon) set the profile and the DATABASE_* values:
#
#   spring.profiles.active=postgres        (in this file; as a real OS environment variable it is SPRING_PROFILES_ACTIVE)
#
# Neon shows a connection string like
#   postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&channel_binding=require
# Turn it into these three settings (drop channel_binding; JDBC takes user and password separately):
#   DATABASE_URL=jdbc:postgresql://HOST/DBNAME?sslmode=require
#   DATABASE_USERNAME=USER
#   DATABASE_PASSWORD=PASSWORD
#
# If HOST contains "-pooler" (Neon's pooled endpoint), migrations still need the DIRECT host (same name without "-pooler"):
#   DATABASE_MIGRATION_URL=jdbc:postgresql://HOST_WITHOUT_-POOLER/DBNAME?sslmode=require
# DATABASE_POOL_SIZE=5        (Postgres profile; SQLite always uses 1)
#
# The schema is created and upgraded by Flyway on startup (db/migration/postgresql). Neon suspends idle compute, so the
# first request after a quiet period can take a few seconds while it wakes.
# JPA_DDL_AUTO=none          (validate on PostgreSQL; SQLite's INTEGER keys fail Hibernate's validator)
# RATE_LIMIT_AUTH_PER_MINUTE=20   (per client IP on /api/v1/auth/**)
# spring.profiles.active=prod,postgres   (structured logs; refuses to start with MAIL_ENABLED=false or CORS=*)
# APP_JWT_TTL_DAYS=30
# APP_OTP_TTL_MINUTES=10
# APP_OTP_RESEND_SECONDS=30
# APP_OTP_MAX_ATTEMPTS=5
# Admin / operations API (/api/v1/admin/**), e.g. database backups. Unset = the endpoints do not exist (404).
# At least 32 random characters:  openssl rand -hex 32     Send it as the X-Admin-Token header.
# ADMIN_API_TOKEN=
# BACKUP_DIR=./data/backups   (where backups are written; mount a persistent volume here in production)
# BACKUP_KEEP=14              (newest N backups are kept)

# Comma-separated origins allowed to call the API (default: any). Example: https://splitbuys.example.com
# CORS_ALLOWED_ORIGINS=http://localhost:5555

# Email OTPs. Leave MAIL_ENABLED=false to print codes to the server console instead.
# For Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it below (16 letters, no spaces).
# Use your real Gmail address and the app password, not your normal password.
MAIL_ENABLED=false
# MAIL_USERNAME=you@gmail.com
# MAIL_PASSWORD=
# MAIL_FROM=you@gmail.com
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
